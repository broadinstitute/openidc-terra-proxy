# Build the introspection endpoint (introspect/). go-toolset comes from the UBI repo
# rather than the ubi8/go-toolset image, which lags it; Go compiles its standard
# library (crypto/tls, net/http) into the binary, so the toolchain version matters.
FROM registry.access.redhat.com/ubi8/ubi-minimal AS introspect
RUN microdnf --nodocs -y install go-toolset && microdnf clean all
WORKDIR /src
COPY introspect/ .
RUN go vet ./... && go test ./... && go build -trimpath -o /introspect .

FROM registry.access.redhat.com/ubi8/ubi-minimal

ENV LIBOAUTH2_VERSION=1.4.5.1 \
  OAUTH2_VERSION=3.2.3

# Red Hat's php:8.2 module stream lags upstream security releases, so take PHP 8.2 from Remi's
# repository instead. The AppStream php module has to be disabled or it masks Remi's packages.
# The signing key is pinned in this repo rather than fetched at build time. Its fingerprint,
# 6B38 FEA7 231F 87F5 2B9C  A9D8 5550 9759 5F11 735A, matches https://rpms.remirepo.net/KEYS.txt.
COPY RPM-GPG-KEY-remi2018 /etc/pki/rpm-gpg/RPM-GPG-KEY-remi2018
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-remi2018 \
  && printf '%s\n' \
    '[remi-php82]' \
    'name=Remi PHP 8.2 for Enterprise Linux 8' \
    'baseurl=https://rpms.remirepo.net/enterprise/8/php82/$basearch/' \
    'enabled=1' \
    'gpgcheck=1' \
    'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-remi2018' \
    'module_hotfixes=1' \
    > /etc/yum.repos.d/remi-php82.repo \
  && microdnf -y module disable php

# Install dependencies
RUN microdnf --nodocs -y install \
  httpd \
  procps \
  wget \
  tar \
  openssl \
  jansson \
  libmemcached \
  mod_ssl \
  mod_ldap \
  && microdnf clean all

# Install hiredis (dependency of liboauth2) from EPEL
RUN rpm -ivh https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm \
  && microdnf --nodocs -y install \
  hiredis-0.13.3-13.el8.x86_64 \
  && microdnf clean all

# Install mod_oauth2 module
RUN rpm -ivh \
  https://mod-auth-openidc.org/downloads/cjose-0.6.1.5-2.el8.x86_64.rpm \
  https://github.com/zmartzone/liboauth2/releases/download/v${LIBOAUTH2_VERSION}/liboauth2-${LIBOAUTH2_VERSION}-1.el8.x86_64.rpm \
  https://github.com/zmartzone/liboauth2/releases/download/v${LIBOAUTH2_VERSION}/liboauth2-apache-${LIBOAUTH2_VERSION}-1.el8.x86_64.rpm \
  https://github.com/zmartzone/mod_oauth2/releases/download/v${OAUTH2_VERSION}/mod_oauth2-${OAUTH2_VERSION}-1.el8.x86_64.rpm

# Copy configs
COPY site.conf graceful_shutdown.conf mpm_event.conf oauth2.conf ssl_fips.conf introspect.conf /etc/httpd/conf.d/
COPY --from=introspect /introspect /app/introspect/introspect
COPY run-httpd /usr/bin
COPY setup-httpd.sh /tmp/build/setup-httpd.sh

# Setup httpd
RUN chmod a+x /usr/bin/run-httpd \
  && chmod a+x /tmp/build/setup-httpd.sh \
  && /tmp/build/setup-httpd.sh \
  && sed -i 's/Listen 80/Listen 80\nListen 443/' /etc/httpd/conf/httpd.conf \
  && rm -rf /tmp/build

EXPOSE 80
EXPOSE 443

# Apache runs graceful stop only upon SIGWINCH. Normal SIGTERM is an immediate stop.
# GracefulShutdownTimeout directive configured via graceful_shutdown.conf.
# https://httpd.apache.org/docs/2.4/stopping.html
STOPSIGNAL SIGWINCH

CMD ["/usr/bin/run-httpd"]
